{
  "name": "infrctl",
  "version": "0.1.0",
  "description": "Five local AI model families. One CLI.",
  "license": "MIT",
  "author": "iljanemesis",
  "keywords": [
    "ai",
    "cli",
    "local-ai",
    "ollama",
    "llm",
    "qwen",
    "deepseek",
    "llama",
    "gemma",
    "phi"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infrctl/infrctl-cli.git"
  },
  "bugs": {
    "url": "https://github.com/infrctl/infrctl-cli/issues"
  },
  "homepage": "https://github.com/infrctl/infrctl-cli#readme",
  "type": "module",
  "bin": {
    "infrctl": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "npm run build && npm run lint && npm test && npm pack --dry-run",
    "audit:prod": "npm audit --omit=dev",
    "format": "prettier --write .",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.3.2",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "execa": "^9.5.2",
    "fastify": "^5.2.1",
    "ora": "^8.2.0",
    "systeminformation": "^5.25.11",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  }
}
